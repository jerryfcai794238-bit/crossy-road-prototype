{
  "name": "crossy-road-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:game": "esbuild src/main.js --bundle --outfile=dist/bundle.js --format=iife --target=es2020",
    "build:tutorial-scenes": "esbuild src/embed/tutorial-scenes.js --bundle --outfile=docs/assets/tutorial-scenes.iife.js --format=iife --global-name=CrossyRoadTutorialScenes --target=es2020",
    "build": "npm run build:game && npm run build:tutorial-scenes",
    "preview": "vite preview"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vite": "^5.0.12"
  }
}
